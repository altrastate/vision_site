# VISION environment template — placeholders only. Copy to .env.local.
# Public values are safe for the browser. Secret keys must never be prefixed with NEXT_PUBLIC_.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project URL (hosted: https://<project-ref>.supabase.co — no /rest/v1 suffix)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Legacy anon JWT keys are accepted only for compatibility.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...). Server-only. Never expose this to the browser.
# Legacy service_role JWT keys are accepted only for compatibility.
SUPABASE_SECRET_KEY=
